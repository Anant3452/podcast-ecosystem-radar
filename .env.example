# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=
# Any Gemini Flash model id; default below if unset.
GEMINI_MODEL=gemini-3.5-flash-lite
# Postgres connection string (Neon / Vercel Postgres in production; local Postgres for dev).
DATABASE_URL=postgres://user:password@host:5432/radar
RESEND_API_KEY=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 24
CRON_SECRET=
# Password for the /admin "Run ingestion now" button. Generate with: openssl rand -hex 24
ADMIN_SECRET=
EMAIL_FROM="Podcast Radar <onboarding@resend.dev>"
# Optional: comma-separated recipients overriding config/settings.json (useful while Resend is in sandbox mode).
BRIEF_RECIPIENTS=
